# 根目录白名单：解码及处理中间数据默认留在本地。
/*
!/AGENTS.md
!/README.md
!/LICENSE
!/.gitignore
!/analysis/

# 自动能量刻度：源码、配置和小型回查结果；数据与编译产物仍排除。
!/calibration/
/calibration/*
!/calibration/energy/
/calibration/energy/**
!/calibration/energy/**/
!/calibration/energy/autocal/Makefile
!/calibration/energy/**/*.cc
!/calibration/energy/**/*.cpp
!/calibration/energy/**/*.hh
!/calibration/energy/**/*.h
!/calibration/energy/**/*.md
!/calibration/energy/**/*.csv
!/calibration/energy/**/*.json
!/calibration/energy/**/*.png

# 直接科学处理：决策／计划只收 Markdown，时间对齐只收可复现的小型产物。
!/decisions/
/decisions/*
!/decisions/*.md
!/time_offset/
/time_offset/**
!/time_offset/**/
!/time_offset/**/Makefile
!/time_offset/time_offset/run.sh
!/time_offset/**/*.py
!/time_offset/**/*.cc
!/time_offset/**/*.cpp
!/time_offset/**/*.hh
!/time_offset/**/*.h
!/time_offset/**/*.md
!/time_offset/**/*.csv
!/time_offset/**/*.json
!/time_offset/**/*.dat
!/time_offset/**/*.svg
!/time_offset/**/*.txt
!/time_offset/**/*.md5
/time_offset/**/secrets*.txt
/time_offset/**/secrets*.md5
/time_offset/**/credentials*.txt
/time_offset/**/credentials*.md5

!/.githooks/
!/.agents/
/.agents/*
!/.agents/skills/
!/.codex/

# 本地配置、身份凭据及运行状态。
**/.env
**/.env.*
**/credentials
**/credentials.json
**/credentials.toml
**/credentials.yaml
**/credentials.yml
**/credentials.ini
**/secrets.json
**/secrets.toml
**/secrets.yaml
**/secrets.yml
**/*.pem
**/*.key
**/auth.json
**/config.local.*
/.codex/**/sessions/
/.codex/**/logs/
/.codex/**/*.sqlite*
/.codex/**/history.jsonl

# 大型数据与数据容器；小型标定配置 .dat 允许跟踪。
**/*.root
**/*.bin
**/*.h5
**/*.hdf5
**/*.npy
**/*.npz
**/*.parquet
**/*.arrow
**/*.zip
**/*.tar
**/*.gz
**/*.7z

# 编译产物和缓存。
**/__pycache__/
**/.pytest_cache/
**/.ipynb_checkpoints/
**/.venv/
**/venv/
**/node_modules/
**/build/
**/*.pyc
**/*.o
**/*.so
**/*.a
**/*.exe
**/*~
/decode_data/DecodeAndSortAll/decodeandsort
.omx-state-locks/
.omx-state-locks.identity.json
.codex/*
!.codex/agents/
!.codex/agents/**
!.codex/skills/
!.codex/skills/**
.codex/skills/.system/**
!.codex/prompts/
!.codex/prompts/**

# 项目安装的持久配置；环境、会话与hook信任记录留在本地。
!.codex/config.toml
!.codex/hooks.json
/.codex/hooks-trust.toml
/.codex/.omx/
/.codex/*.tmp
/.codex/.ponytail*
!/.omx/
/.omx/*
!/.omx/setup-scope.json
!/.omx/hud-config.json

# 上游开发测试输出以及 Python 包构建元数据。
**/*.egg-info/
**/target/
**/coverage/
/analysis/vendor/oh-my-codex/dist/

# 官方解码源码保留用户移动位置；同目录其他文件默认忽略。
!/decode_data/
