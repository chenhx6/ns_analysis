# 根目录白名单：解码及处理中间数据默认留在本地。
/*
!/AGENTS.md
!/README.md
!/.gitignore
!/analysis/
!/skills/
!/.githooks/
!/.agents/
/.agents/*
!/.agents/skills/
!/.codex/

# 本地配置、身份凭据及运行状态。
**/.env
**/.env.*
**/credentials
**/credentials.json
**/credentials.toml
**/credentials.yaml
**/credentials.yml
**/credentials.ini
**/secrets.json
**/secrets.toml
**/secrets.yaml
**/secrets.yml
**/*.pem
**/*.key
**/auth.json
**/config.local.*
/.codex/**/sessions/
/.codex/**/logs/
/.codex/**/*.sqlite*
/.codex/**/history.jsonl

# 大型数据与数据容器；小型标定配置 .dat 允许跟踪。
**/*.root
**/*.bin
**/*.h5
**/*.hdf5
**/*.npy
**/*.npz
**/*.parquet
**/*.arrow
**/*.zip
**/*.tar
**/*.gz
**/*.7z

# 编译产物和缓存。
**/__pycache__/
**/.pytest_cache/
**/.ipynb_checkpoints/
**/.venv/
**/venv/
**/node_modules/
**/build/
**/*.pyc
**/*.o
**/*.so
**/*.a
**/*.exe
**/*~
/analysis/code/DecodeAndSortAll/decodeandsort
.omx-state-locks/
.omx-state-locks.identity.json
.codex/*
!.codex/agents/
!.codex/agents/**
!.codex/skills/
!.codex/skills/**
.codex/skills/.system/**
!.codex/prompts/
!.codex/prompts/**

# 项目安装的持久配置；环境、会话与hook信任记录留在本地。
!.codex/config.toml
!.codex/hooks.json
/.codex/hooks-trust.toml
/.codex/.omx/
/.codex/*.tmp
/.codex/.ponytail*
/.omx/

# 上游开发测试输出以及 Python 包构建元数据。
**/*.egg-info/
**/target/
**/coverage/
/analysis/vendor/oh-my-codex/dist/
